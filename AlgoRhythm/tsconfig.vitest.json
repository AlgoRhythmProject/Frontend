{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "vitest.config.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/tests/e2e",
    "src/tests/ui",
    "**/*.spec.ts"
  ]
}